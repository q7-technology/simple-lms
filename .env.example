# Copy to .env and fill in. Nothing here is committed.

# Postgres (used by the db and api containers)
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me
# Host port the database is published on (127.0.0.1 only). 5435 sits beside
# Simple WMS's 5433 and Simple TMS's 5434. The tests expect
# POSTGRES_PASSWORD=lms-dev on this port unless TEST_DATABASE_URL says otherwise.
POSTGRES_PORT=5435

# API
# Host port the API is published on, for local work and health checks.
# Caddy is still the only door from outside. 8033, beside Simple WMS's 8011
# and Simple TMS's 8022.
LMS_API_PORT=8033
# Whose "today" decides what is current, expiring or lapsed.
LMS_TIMEZONE=Australia/Melbourne

# Where people open Simple LMS, for the links in emails, e.g.
# https://lms.example.com.au. Leave empty and the emails carry no link.
LMS_PUBLIC_URL=

# Email (the worker sends reminders and the managers' Monday digest).
# Without LMS_SMTP_HOST and LMS_SMTP_FROM the emails wait in the outbox,
# unsent, until they are set. LMS_SMTP_SECURITY is starttls (port 587),
# ssl (port 465) or none (a relay on your own network).
LMS_SMTP_HOST=
LMS_SMTP_PORT=587
LMS_SMTP_USER=
LMS_SMTP_PASSWORD=
# The sender, e.g. Simple LMS <lms@yourcompany.com.au>.
LMS_SMTP_FROM=
LMS_SMTP_SECURITY=starttls
# The hour (0 to 23, in LMS_TIMEZONE) from which the daily job runs each day.
LMS_DAILY_HOUR=6

# After three goes at a module's quiz in a row that didn't pass, how many
# minutes the learner waits before the next, e.g. 1440 for a day. 0 turns
# the wait off.
LMS_QUIZ_COOLDOWN_MINUTES=60

# Caddy: the public host name. "localhost" gives a self-signed local cert.
LMS_DOMAIN=localhost
# Host ports Caddy listens on. Keep 80 and 443 for a real domain: Let's
# Encrypt only checks those. Other ports (say 8280 and 8643 beside a
# sibling's Caddy) are for local work and a LAN only.
LMS_HTTP_PORT=80
LMS_HTTPS_PORT=443
