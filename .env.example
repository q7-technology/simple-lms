# Copy to .env and fill in. Nothing here is committed.
#
# The LMS_ settings marked "Settings" can also be set by an admin on the
# desktop's Settings screen, which wins over what is here and needs no
# restart. Leave them here and an install keeps working as it always has.
# The rest are needed before Simple LMS starts, so they live here only.

# Postgres (used by the db and api containers)
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me
# Host port the database is published on (127.0.0.1 only). 5435 sits beside
# Simple WMS's 5433 and Simple TMS's 5434. The tests expect
# POSTGRES_PASSWORD=lms-dev on this port unless TEST_DATABASE_URL says otherwise.
POSTGRES_PORT=5435

# API
# Host port the API is published on, for local work and health checks.
# Caddy is still the only door from outside. 8033, beside Simple WMS's 8011
# and Simple TMS's 8022.
LMS_API_PORT=8033
# Whose "today" decides what is current, expiring or lapsed. Settings.
LMS_TIMEZONE=Australia/Melbourne

# Where people open Simple LMS, for the links in emails and where Microsoft
# sends people back, e.g. https://lms.example.com.au (with the port, if it
# isn't 443). Leave empty and the emails carry no link and nobody can sign
# in with Microsoft. Settings.
LMS_PUBLIC_URL=

# Sign in with Microsoft Entra ID (README: "Sign in with Microsoft"). The
# app registered in your tenant: its Directory (tenant) ID, Application
# (client) ID and a client secret's Value. Here only, not in Settings: the
# secret is a secret. Leave any empty and the "Sign in with Microsoft"
# button never shows.
LMS_ENTRA_TENANT_ID=
LMS_ENTRA_CLIENT_ID=
LMS_ENTRA_CLIENT_SECRET=

# Email (the worker sends reminders and the managers' Monday digest).
# Without LMS_SMTP_HOST and LMS_SMTP_FROM the emails wait in the outbox,
# unsent, until they are set. LMS_SMTP_SECURITY is starttls (port 587),
# ssl (port 465) or none (a relay on your own network). All Settings, where
# a test email can be sent too.
LMS_SMTP_HOST=
LMS_SMTP_PORT=587
LMS_SMTP_USER=
LMS_SMTP_PASSWORD=
# The sender, e.g. Simple LMS <lms@yourcompany.com.au>.
LMS_SMTP_FROM=
LMS_SMTP_SECURITY=starttls
# The hour (0 to 23, in LMS_TIMEZONE) from which the daily job runs each day.
# Settings, with the reminder days (30, 14 and 0 unless changed there).
LMS_DAILY_HOUR=6

# After three goes at a module's quiz in a row that didn't pass, how many
# minutes the learner waits before the next, e.g. 1440 for a day. 0 turns
# the wait off. Settings, with how many goes (3 unless changed there).
LMS_QUIZ_COOLDOWN_MINUTES=60

# Printing: certificates and skills cards go to Platen as a template name and
# JSON. LMS_PLATEN_URL is its intake, e.g. https://platen.example.com.au/intake/jobs
# (on this machine, outside Compose: http://host.docker.internal:<port>/intake/jobs).
# LMS_PLATEN_KEY is a key made in Platen for Simple LMS. The printers are a
# Platen printer's id or name; the skills cards' is the certificates' unless
# it says otherwise. Without an address nothing can be printed. All Settings.
LMS_PLATEN_URL=
LMS_PLATEN_KEY=
LMS_CERTIFICATE_PRINTER=office
LMS_SKILLS_CARD_PRINTER=

# Webhooks (added on the Settings screen) go to public addresses only: the
# worker won't connect to this machine, the local network or a cloud's
# metadata service for one, nor follow a redirect. Set true to let a webhook
# reach a receiver on this machine (http://host.docker.internal:<port>/...) or
# the local network. Only here, never on the Settings screen. Platen isn't
# affected. LMS_WORKER_HTTP_TIMEOUT_SECONDS: how long the worker waits for a
# webhook or Platen to answer.
LMS_WEBHOOK_ALLOW_PRIVATE=false
LMS_WORKER_HTTP_TIMEOUT_SECONDS=10

# Caddy: the public host name. "localhost" gives a self-signed local cert.
LMS_DOMAIN=localhost
# Host ports Caddy listens on. Keep 80 and 443 for a real domain: Let's
# Encrypt only checks those. Other ports (say 8280 and 8643 beside a
# sibling's Caddy) are for local work and a LAN only.
LMS_HTTP_PORT=80
LMS_HTTPS_PORT=443
